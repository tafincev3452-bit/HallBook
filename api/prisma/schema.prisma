generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  photo           String?
  role            String
  position        String?
  tipLink         String?
  isBlocked       Boolean  @default(false)
  establishmentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shifts          Shift[]
  hookahOrders    HookahOrder[]
}

model Establishment {
  id                String   @id @default(cuid())
  name              String
  subdomain         String   @unique
  logo              String?
  style             Json?
  seasonalFx        Boolean  @default(true)
  staffDiscount     Json?
  subscriptionUntil DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tables            Table[]
  bookings          Booking[]
  shifts            Shift[]
  reviews           Review[]
  menuItems         MenuItem[]
  promotions        Promotion[]
  techCards         TechCard[]
}

model Table {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  x               Float
  y               Float
  seats           Int
  isActive        Boolean  @default(true)

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  bookings        Booking[]
  hookahOrders    HookahOrder[]
}

model Booking {
  id              String   @id @default(cuid())
  tableId         String
  establishmentId String
  guestName       String
  guestPhone      String
  date            DateTime
  guestsCount     Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  table           Table @relation(fields: [tableId], references: [id])
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model Shift {
  id              String   @id @default(cuid())
  userId          String
  establishmentId String
  date            DateTime
  startTime       String
  endTime         String
  status          String   @default("planned")

  user            User @relation(fields: [userId], references: [id])
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model Review {
  id              String   @id @default(cuid())
  establishmentId String
  authorName      String
  text            String
  rating          Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model MenuItem {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  price           Int
  category        String
  isActive        Boolean  @default(true)

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  techCards       TechCard[]
}

model Promotion {
  id              String   @id @default(cuid())
  establishmentId String
  title           String
  description     String
  isActive        Boolean  @default(true)

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model TechCard {
  id              String   @id @default(cuid())
  establishmentId String
  menuItemId      String?
  title           String
  ingredients     Json
  steps           String[]
  outputWeight    String?
  calories        Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
}

model HookahOrder {
  id              String   @id @default(cuid())
  tableId         String
  masterId        String
  strength        String
  flavors         String[]
  wishes          String?
  status          String   @default("new")
  createdAt       DateTime @default(now())

  table           Table @relation(fields: [tableId], references: [id])
  master          User @relation(fields: [masterId], references: [id])
}